# Servidor
PORT=3000
JWT_SECRET=cambia_esto_por_algo_largo_y_secreto
JWT_EXPIRES_IN=8h
# Sitios que pueden llamar a la API desde el navegador (separados por coma, sin "/" al final)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://danzela1.github.io
# Dirección del sitio web: se usa en los enlaces de los correos (recuperar contraseña)
# En producción: https://danzela1.github.io/PW2OpvDrywall
FRONTEND_URL=http://localhost:5173
# Detrás de un proxy/hosting pon 1 para que el límite de peticiones use la IP real del visitante
TRUST_PROXY=0

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=opv_drywall
DB_USER=root
DB_PASSWORD=

# Archivos subidos (opcional): tamaño máximo en MB y carpeta de destino
# MAX_UPLOAD_MB=5
# UPLOADS_DIR=

# Límite de peticiones por IP cada 15 minutos (opcional)
# RATE_LIMIT_AUTH_MAX=20     # login, registro y recuperar contraseña
# RATE_LIMIT_PUBLIC_MAX=30   # formularios públicos (cotización, contacto, testimonios, postulaciones)

# Correo (Gmail: usa una "contraseña de aplicación" de 16 letras, no tu contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=las16letrasdelacontraseña
CORREO_REMITENTE=OPV Drywall
CORREO_ADMIN=correo_donde_llegara_el_aviso@gmail.com

# Impuesto que se suma a las cotizaciones con detalle (ISV en Honduras: 15)
# IMPUESTO_PORCENTAJE=15
