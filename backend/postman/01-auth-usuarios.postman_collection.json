            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"devuelve token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));",
                  "pm.test(\"no expone el hash\", () => pm.expect(pm.response.json().usuario).to.not.have.property(\"passwordHash\"));",
                  "pm.collectionVariables.set(\"tokenCliente\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
